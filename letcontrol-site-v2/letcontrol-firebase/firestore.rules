rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNÇÕES AUXILIARES ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDeviceOwner(deviceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/devices/$(deviceId)) &&
        get(/databases/$(database)/documents/devices/$(deviceId)).data.user_id == request.auth.uid;
    }

    function isValidReading() {
      let data = request.resource.data;
      return data.keys().hasAll(['device_id', 'user_id', 'flow_rate_lpm', 'timestamp'])
        && data.flow_rate_lpm is number
        && data.flow_rate_lpm >= 0
        && data.flow_rate_lpm <= 100
        && data.pressure_bar is number
        && data.pressure_bar >= 0;
    }

    // ─── USERS ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // nunca deletar via client
    }

    // ─── DEVICES ─────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow read: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
    }

    // ─── READINGS ─────────────────────────────────────────────────
    // Escritas feitas pelo backend/Cloud Function via service account
    // Leitura permitida somente ao dono
    match /readings/{readingId} {
      allow read: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      allow create: if false; // apenas backend (service account)
      allow update: if false;
      allow delete: if false;
    }

    // ─── ALERTS ──────────────────────────────────────────────────
    match /alerts/{alertId} {
      allow read: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      // Usuário pode marcar como lido / resolvido
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'resolved', 'resolved_at']);
      allow create: if false; // apenas backend
      allow delete: if false;
    }

    // ─── GOALS ───────────────────────────────────────────────────
    match /goals/{goalId} {
      allow read: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.limit_liters > 0;
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
    }

    // ─── DAILY REPORTS ────────────────────────────────────────────
    match /daily_reports/{reportId} {
      allow read: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
      allow create: if false; // apenas Cloud Function noturna
      allow update: if false;
      allow delete: if false;
    }
  }
}
